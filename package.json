{
  "name": "govjobpulse",
  "private": true,
  "version": "0.1.0",
  "description": "GovJobPulse — Indian Government Job Portal (monorepo root)",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "clean": "turbo run clean && rm -rf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\" --ignore-path .gitignore"
  },
  "devDependencies": {
    "turbo": "^2.1.3",
    "typescript": "^5.6.3",
    "prettier": "^3.3.3",
    "@types/node": "^22.7.5"
  },
  "pnpm": {
    "overrides": {
      "vitest": "^3.2.6",
      "vite": "^6.4.3",
      "sharp": "^0.35.0",
      "postcss": "^8.5.23",
      "nanoid": "^3.3.17",
      "uuid": "^11.1.1"
    }
  }
}
