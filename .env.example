# GovJobPulse — environment variables
# This file grows phase by phase. Only vars actually consumed by code
# in the current phase are listed — no speculative/future vars.
#
# NODE_ENV — runtime mode for all apps. One of: development | production | test
NODE_ENV=development

# DATABASE_URL — Postgres connection string used by @govjobpulse/database
# (Prisma). Local dev example (matches docker-compose service name once
# that exists; for now, whatever your local Postgres is):
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/govjobpulse"

# NEXT_PUBLIC_SITE_URL — canonical origin used for sitemap.xml,
# news-sitemap.xml, feed.xml, JSON-LD (JobPosting/Organization/
# BreadcrumbList/WebSite), and canonical <link> tags across apps/web.
# Falls back to a placeholder in lib/site.ts if unset, but should always
# be set to the real production domain before deploying.
NEXT_PUBLIC_SITE_URL="https://www.govjobpulse.com"

# REDIS_URL — used by apps/worker's BullMQ notification queues
# (packages/notifications) and by apps/admin's moderation "Publish"
# action (Queue.add() — a producer, not a consumer; see CLAUDE.md's
# Phase 9.5 entry for why admin needs this).
REDIS_URL="redis://localhost:6379"

# WORKER_HEALTH_PORT — apps/worker has no HTTP server otherwise (it's
# cron jobs + CLI scripts); this is the minimal health-check server's
# port (Section 9's /health /ready /live). Defaults to 3002.
WORKER_HEALTH_PORT=3002

# Notification provider credentials (packages/notifications) — every
# adapter is disabled by default (see base-provider.ts) until its
# required vars below are set AND it's enabled in the admin panel
# (Phase 9). None of these are required to run the app; add only the
# ones for platforms you're actually turning on. Full list, per
# provider file in packages/notifications/src/providers/:
#   Telegram: TELEGRAM_BOT_TOKEN, TELEGRAM_CHAT_ID
#   Facebook: FACEBOOK_PAGE_ID, FACEBOOK_PAGE_ACCESS_TOKEN
#   Instagram: INSTAGRAM_BUSINESS_ACCOUNT_ID, INSTAGRAM_ACCESS_TOKEN
#   LinkedIn: LINKEDIN_ORGANIZATION_URN, LINKEDIN_ACCESS_TOKEN
#   WhatsApp: WHATSAPP_PHONE_NUMBER_ID, WHATSAPP_ACCESS_TOKEN, WHATSAPP_CHANNEL_ID, WHATSAPP_TEMPLATE_NAME
#   Email: EMAIL_API_KEY, EMAIL_FROM_ADDRESS, EMAIL_NOTIFICATION_TEST_RECIPIENT (test-only until Phase 10's subscriber list exists)
#   Push: FCM_PROJECT_ID, FCM_SERVER_KEY, PUSH_NOTIFICATION_TEST_DEVICE_TOKEN (test-only until Phase 10)
#   Twitter/X: TWITTER_USER_ACCESS_TOKEN

# Vars for JWT_SECRET etc. will be added in the phases that introduce
# the code that consumes them (Phase 14 auth, ...).
# See CLAUDE.md "Environment variables" section for the running log.
