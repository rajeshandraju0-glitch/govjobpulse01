# GovJobPulse — environment variables
# This file grows phase by phase. Only vars actually consumed by code
# in the current phase are listed — no speculative/future vars.
#
# NODE_ENV — runtime mode for all apps. One of: development | production | test
NODE_ENV=development

# Vars for DATABASE_URL, REDIS_URL, JWT_SECRET, notification provider
# credentials, etc. will be added in the phases that introduce the
# code that consumes them (Phase 2 database, Phase 8 notifications, ...).
# See CLAUDE.md "Environment variables" section for the running log.
