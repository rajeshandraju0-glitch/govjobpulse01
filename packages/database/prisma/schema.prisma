// GovJobPulse database schema
// See CLAUDE.md "Architecture decisions" for the reasoning behind
// modeling choices not explicitly spelled out in the build brief
// (Category/State as real tables, Qualification as a scalar array,
// archival-by-status-not-deletion, RBAC roles).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

// draft -> reviewed -> published per Section 4's moderation gate.
// Deliberately no "expired"/"archived" state: expired jobs stay PUBLISHED
// (frontend derives "applications closed" from applicationEnd at query
// time) so their pages keep earning SEO long-tail traffic per Section 6.
enum JobStatus {
  DRAFT
  REVIEWED
  PUBLISHED
}

enum JobType {
  FULL_TIME
  PART_TIME
  CONTRACT
  APPRENTICESHIP
  INTERNSHIP
}

// Section 3: "Qualification pages: 10th, 12th, ITI, Diploma, Graduate, PG,
// B.Tech, M.Tech, MBA, LLB, MBBS, PhD." Modeled as an enum used in a scalar
// array on Job (a posting can accept multiple qualification levels), not a
// join table — Section 3 lists this as a Job field, not a supporting table.
enum QualificationLevel {
  TENTH
  TWELFTH
  ITI
  DIPLOMA
  GRADUATE
  POST_GRADUATE
  B_TECH
  M_TECH
  MBA
  LLB
  MBBS
  PHD
}

enum ScraperRunStatus {
  SUCCESS
  FAILED
  PARTIAL
}

// Section 7: notification system foundation. Mirrors NotificationSendResult
// in packages/types (SENT/FAILED/SKIPPED_DISABLED) plus queue-lifecycle
// states a DB row can be in before a send is even attempted.
enum NotificationStatus {
  PENDING
  SENT
  FAILED
  SKIPPED_DISABLED
}

// Section 7's 8 platforms, mirrored as an enum for the DB layer (the
// TS-level NotificationProvider.slug in packages/notifications uses
// matching string values — kept in sync manually since this schema and
// that package don't share a generated type in either direction).
enum NotificationPlatform {
  TELEGRAM
  FACEBOOK
  INSTAGRAM
  LINKEDIN
  WHATSAPP
  EMAIL
  PUSH
  TWITTER
}

// Section 8: email subscription foundations. PENDING until the
// verification link is clicked — an unverified address never receives
// anything, so a typo'd/hostile signup can't be used to spam a stranger.
enum SubscriberStatus {
  PENDING
  VERIFIED
  UNSUBSCRIBED
}

// Section 8: push notification foundations. Web Push (VAPID) and native
// FCM/APNs tokens have different shapes but the same lifecycle, so one
// model with a platform discriminator rather than three separate tables.
enum PushPlatform {
  WEB
  IOS
  ANDROID
}

// RBAC per CLAUDE.md's resolved open item. GUEST is not a DB row — it's
// simply the absence of an authenticated User.
enum UserRole {
  USER
  ADMIN
  SUPER_ADMIN
}

// ---------------------------------------------------------------------------
// Core content model (Section 3)
// ---------------------------------------------------------------------------

model Job {
  id     String @id @default(cuid())
  title  String
  slug   String @unique

  department String

  organization   Organization @relation(fields: [organizationId], references: [id])
  organizationId String

  advertisementNumber String?
  vacancies           Int?
  qualifications      QualificationLevel[]
  salary              String?
  ageLimit            String?

  applicationStart DateTime?
  applicationEnd   DateTime?
  examDate         DateTime?

  category   Category @relation(fields: [categoryId], references: [id])
  categoryId String

  states JobState[]

  jobType JobType

  officialNotificationUrl String
  officialApplyUrl        String?
  officialWebsite         String

  description       String
  howToApply         String?
  selectionProcess   String?
  applicationFee     String?

  seoTitle       String?
  seoDescription String?

  status      JobStatus @default(DRAFT)
  publishedAt DateTime?

  // Provenance — which scraper produced this job, for duplicate detection
  // (Section 4: compare officialNotificationUrl, advertisementNumber, title)
  // and for the admin staleness view. Nullable: an admin-created job has no
  // source.
  source   Source? @relation(fields: [sourceId], references: [id])
  sourceId String?

  bookmarks Bookmark[]
  notifications Notification[]
  views JobView[]
  shareEvents ShareEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Indexes per Section 3: "proper indexes on slug, status, category,
  // state, and application_end (list/filter/sort queries depend on these)."
  // slug is already unique (implicit index). status/categoryId/
  // applicationEnd get explicit indexes; state is indexed on the join table
  // below. officialNotificationUrl + advertisementNumber are indexed to
  // support Section 4's duplicate-detection lookups.
  @@index([status])
  @@index([categoryId])
  @@index([applicationEnd])
  @@index([officialNotificationUrl])
  @@index([advertisementNumber])
  @@index([sourceId])
  @@index([status, publishedAt])
}

model Category {
  id          String  @id @default(cuid())
  name        String  @unique
  slug        String  @unique
  description String?

  jobs Job[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model State {
  id               String  @id @default(cuid())
  name             String  @unique
  slug             String  @unique
  isUnionTerritory Boolean @default(false)

  jobs JobState[]

  createdAt DateTime @default(now())
}

// Explicit join model (not an implicit m2m) so we can index stateId
// directly for state-page queries per Section 3's indexing requirement.
model JobState {
  job     Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  jobId   String
  state   State  @relation(fields: [stateId], references: [id], onDelete: Cascade)
  stateId String

  @@id([jobId, stateId])
  @@index([stateId])
}

model Organization {
  id      String  @id @default(cuid())
  name    String  @unique
  slug    String  @unique
  website String?

  jobs Job[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// One row per official source the scraper system pulls from (SSC, UPSC,
// IBPS, RRB, ISRO, ...). robotsTxt* fields exist so Phase 3's "check
// robots.txt/ToS before scraping" requirement (CLAUDE.md open item) has
// somewhere to record its findings, without this phase implementing the
// actual check.
model Source {
  id       String  @id @default(cuid())
  name     String  @unique
  slug     String  @unique
  baseUrl  String
  isActive Boolean @default(true)

  robotsTxtCheckedAt DateTime?
  robotsTxtAllowed   Boolean?
  robotsTxtNotes      String?

  jobs        Job[]
  scraperLogs ScraperLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Section 4: "Scheduler ... logs every execution (start, end, success/fail,
// error)" and "Admin panel exposes per-source last successful run and
// staleness, not just pass/fail logs."
model ScraperLog {
  id     String @id @default(cuid())
  source Source @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  sourceId String

  status ScraperRunStatus

  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  jobsCreated          Int @default(0)
  jobsUpdated          Int @default(0)
  jobsSkippedDuplicate Int @default(0)

  errorMessage String?

  @@index([sourceId, startedAt])
  @@index([status])
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  role         UserRole @default(USER)

  emailVerified Boolean @default(false)

  bookmarks Bookmark[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
}

model Bookmark {
  id     String @id @default(cuid())
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String
  job    Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  jobId  String

  createdAt DateTime @default(now())

  @@unique([userId, jobId])
  @@index([jobId])
}

// ---------------------------------------------------------------------------
// Notification system foundation (Section 7) — adapters ship disabled by
// default (packages/notifications); these tables exist so the system is
// observable and configurable once an admin turns a platform on (Phase 9's
// Social Integrations panel), without hardcoding any credentials here —
// only *whether* a platform is enabled and *which* env var names it reads
// from are stored; actual secret values stay in environment variables per
// Section 1 rule 7.
// ---------------------------------------------------------------------------

// One row per (job, platform) send *intent* — created when a job is queued
// for notification, independent of how many attempts it takes. Named
// "NotificationProviderConfig" rather than the brief's literal
// "NotificationProviders" to avoid colliding with the TS-level
// NotificationProvider interface in packages/types, which represents the
// adapter class, not this settings row.
model Notification {
  id       String               @id @default(cuid())
  job      Job                  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  jobId    String
  platform NotificationPlatform
  status   NotificationStatus   @default(PENDING)

  // Bridges this permanent Postgres row to the ephemeral BullMQ job in
  // Redis (Redis job data doesn't persist indefinitely) — set once the
  // notification is actually enqueued.
  bullmqJobId String?
  queueName   String?

  logs NotificationLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([jobId])
  @@index([platform, status])
}

// One row per send *attempt* (a Notification with 3 retry attempts gets 3
// NotificationLog rows) — Section 7: "tracking platform, status, retries,
// error message, execution time, timestamps."
model NotificationLog {
  id             String       @id @default(cuid())
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  notificationId String

  attemptNumber Int
  status        NotificationStatus
  errorMessage  String?
  executionMs   Int?

  createdAt DateTime @default(now())

  @@index([notificationId])
}

// Per-platform enable/disable + which env vars it reads from — the
// DB-level half of the two-layer gate described in
// packages/notifications/src/base-provider.ts (code-level isEnabled()
// checks the env vars actually being present; this table is the
// admin-facing on/off switch on top of that). No secret VALUES live
// here, only which var NAMES are expected — Section 1 rule 7.
model NotificationProviderConfig {
  id       String               @id @default(cuid())
  platform NotificationPlatform @unique
  enabled  Boolean              @default(false)

  // e.g. ["TELEGRAM_BOT_TOKEN", "TELEGRAM_CHAT_ID"] — documents what
  // this platform needs without storing the values themselves.
  requiredEnvVars String[]

  lastHealthCheckAt      DateTime?
  lastHealthCheckHealthy Boolean?
  lastHealthCheckDetail  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Snapshot of an enqueued BullMQ job for admin visibility/history —
// BullMQ/Redis is the source of truth while a job is in flight, but
// completed/failed jobs age out of Redis; this table is what survives
// that and what Phase 9's admin panel queries against, rather than
// reaching into Redis directly from a request handler.
model NotificationQueueEntry {
  id          String @id @default(cuid())
  queueName   String
  bullmqJobId String

  notificationId String?

  status      NotificationStatus @default(PENDING)
  attemptsMade Int               @default(0)

  enqueuedAt  DateTime  @default(now())
  completedAt DateTime?

  @@index([queueName, status])
  @@index([bullmqJobId])
}

// Site-wide notification settings not scoped to any one platform — e.g.
// a global kill switch, or digest send times. Deliberately a single-row
// table (enforced at the application layer, not the schema, since Prisma
// has no clean "exactly one row" constraint) rather than one row per
// something, since these are genuinely global.
model NotificationSettings {
  id String @id @default(cuid())

  globalKillSwitchEnabled Boolean @default(false)
  dailyDigestSendHourUtc  Int     @default(3)
  weeklyDigestDayOfWeek   Int     @default(1) // 0 = Sunday

  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Subscription foundations (Section 8) — "architecture only, no provider
// integration yet." This is the data model + verification/unsubscribe
// lifecycle; actual digest content assembly and sending are explicitly
// out of scope for this phase (see CLAUDE.md's Phase 10 entry for the
// real interface-mismatch reason why).
// ---------------------------------------------------------------------------

model NewsletterSubscriber {
  id     String           @id @default(cuid())
  email  String           @unique
  status SubscriberStatus @default(PENDING)

  // Single-use, expiring — an unverified signup can't sit around
  // forever as a live verification link.
  verificationToken          String?   @unique
  verificationTokenExpiresAt DateTime?

  // Always present so an unsubscribe link works even for a still-PENDING
  // subscriber (someone should be able to back out before ever verifying).
  unsubscribeToken String @unique

  dailyDigest  Boolean @default(true)
  weeklyDigest Boolean @default(false)

  subscribedAt   DateTime  @default(now())
  verifiedAt     DateTime?
  unsubscribedAt DateTime?

  @@index([status])
  @@index([verificationToken])
  @@index([unsubscribeToken])
}

model PushSubscription {
  id       String       @id @default(cuid())
  endpoint String       @unique
  platform PushPlatform
  active   Boolean      @default(true)

  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  @@index([active])
}

// ---------------------------------------------------------------------------
// Analytics foundations (Section 9) — "Track (no external analytics
// integration yet): most viewed jobs, most searched keywords, most
// shared/bookmarked jobs, traffic source, top categories, top states."
// First-party event tables, not a third-party analytics SDK — Section 9
// is explicit no external integration exists yet. Every count derived
// from these is real (Section 1 rule 2): nothing here is a fabricated
// "trending" number, it's aggregated from rows that only exist because
// a real page view/search/share actually happened.
// ---------------------------------------------------------------------------

model JobView {
  id    String @id @default(cuid())
  job   Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  jobId String

  // "Traffic source" per Section 9 — the raw referrer header, not a
  // parsed/categorized source, since parsing referrers into named
  // categories (search/social/direct/...) is a real feature that
  // deserves its own design pass, not a guess bolted on here.
  referrer String?

  viewedAt DateTime @default(now())

  @@index([jobId, viewedAt])
}

model SearchQuery {
  id           String @id @default(cuid())
  query        String
  resultsCount Int
  searchedAt   DateTime @default(now())

  // Composite, not just @@index([searchedAt]) alone — Section 10:
  // "query optimization." getMostSearchedKeywords (apps/web/lib/analytics.ts)
  // filters on searchedAt AND groups by query in the same query; a
  // composite index lets Postgres satisfy both the range filter and
  // the grouping from one index scan instead of filtering via the
  // index then sorting/hashing query values separately.
  @@index([searchedAt, query])
}

enum ShareChannel {
  FACEBOOK
  LINKEDIN
  TWITTER
  TELEGRAM
  WHATSAPP
  COPY_LINK
}

model ShareEvent {
  id      String       @id @default(cuid())
  job     Job          @relation(fields: [jobId], references: [id], onDelete: Cascade)
  jobId   String
  channel ShareChannel
  sharedAt DateTime    @default(now())

  @@index([jobId, sharedAt])
}
